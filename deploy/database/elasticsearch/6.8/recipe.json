{
  "database": "elasticsearch",
  "name": "Elasticsearch",
  "version": "6.8",
  "displayVersion": "6.8",
  "image": "docker.cnb.cool/znb/images/elasticsearch:6.8",
  "platforms": ["linux/amd64", "linux/arm64"],
  "service": "database",
  "defaultPort": 9200,
  "connection": { "host": "127.0.0.1", "port": 11500, "authentication": "none", "database": "dbx", "transportPort": 11501 },
  "hostPorts": { "DB_PORT": 11500, "ELASTICSEARCH_TRANSPORT_PORT": 11501 },
  "shell": ["bash"],
  "smoke": { "steps": [{ "name": "index a smoke document", "command": ["bash", "-c", "curl --fail --silent --show-error -X PUT -H 'Content-Type: application/json' -d '{\"message\":\"DBX smoke\"}' 'http://127.0.0.1:9200/dbx-smoke/_doc/1?refresh=true'"], "expect": "\"result\"" }, { "name": "read the smoke document", "command": ["bash", "-c", "curl --fail --silent --show-error http://127.0.0.1:9200/dbx-smoke/_doc/1"], "expect": "DBX smoke" }] }
}
