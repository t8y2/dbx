#!/usr/bin/env sh
set -eu
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

java_major() {
  "$1" -version 2>&1 | awk -F'[\".]' '/version/ { if ($2 == "1") print $3; else print $2; exit }'
}

supports_java_21() {
  [ -x "$1" ] || return 1
  JAVA_CANDIDATE_MAJOR="$(java_major "$1" || true)"
  case "$JAVA_CANDIDATE_MAJOR" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$JAVA_CANDIDATE_MAJOR" -ge 21 ]
}

JAVA_BIN=""
if [ -n "${DBX_JAVA_BIN:-}" ] && supports_java_21 "$DBX_JAVA_BIN"; then
  JAVA_BIN="$DBX_JAVA_BIN"
elif [ -n "${JAVA_HOME:-}" ] && supports_java_21 "$JAVA_HOME/bin/java"; then
  JAVA_BIN="$JAVA_HOME/bin/java"
else
  PATH_ENTRIES="${PATH:-}"
  PATH_LAST=0
  while :; do
    case "$PATH_ENTRIES" in
      *:*)
        PATH_DIR="${PATH_ENTRIES%%:*}"
        PATH_ENTRIES="${PATH_ENTRIES#*:}"
        ;;
      *)
        PATH_DIR="$PATH_ENTRIES"
        PATH_ENTRIES=""
        PATH_LAST=1
        ;;
    esac
    [ -n "$PATH_DIR" ] || PATH_DIR="."
    CANDIDATE="$PATH_DIR/java"
    if supports_java_21 "$CANDIDATE"; then
      JAVA_BIN="$CANDIDATE"
      break
    fi
    [ "$PATH_LAST" -eq 1 ] && break
  done
  if [ -z "$JAVA_BIN" ]; then
    for CANDIDATE in "/opt/homebrew/opt/openjdk/bin/java" "/usr/local/opt/openjdk/bin/java"; do
      if supports_java_21 "$CANDIDATE"; then
        JAVA_BIN="$CANDIDATE"
        break
      fi
    done
  fi
fi

if [ -z "$JAVA_BIN" ]; then
  echo "Java 21 or newer was not found. Install Java or the optional DBX JDBC runtime." >&2
  exit 127
fi

exec "$JAVA_BIN" \
  -XX:+IgnoreUnrecognizedVMOptions \
  --add-opens=java.base/java.io=ALL-UNNAMED \
  --add-opens=java.base/java.lang=ALL-UNNAMED \
  --add-opens=java.base/java.lang.reflect=ALL-UNNAMED \
  --add-opens=java.base/java.net=ALL-UNNAMED \
  --add-opens=java.base/java.nio=ALL-UNNAMED \
  --add-opens=java.base/java.nio.charset=ALL-UNNAMED \
  --add-opens=java.base/java.text=ALL-UNNAMED \
  --add-opens=java.base/java.time=ALL-UNNAMED \
  --add-opens=java.base/java.util=ALL-UNNAMED \
  --add-opens=java.base/java.util.concurrent=ALL-UNNAMED \
  --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED \
  --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED \
  --add-opens=java.base/jdk.internal.vm=ALL-UNNAMED \
  --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
  --add-opens=java.base/sun.nio.fs=ALL-UNNAMED \
  --add-opens=java.base/sun.security.action=ALL-UNNAMED \
  --add-opens=java.base/sun.security.ssl=ALL-UNNAMED \
  --add-opens=java.base/sun.security.util=ALL-UNNAMED \
  --add-opens=java.security.jgss/sun.security.jgss=ALL-UNNAMED \
  --add-opens=java.security.jgss/sun.security.krb5=ALL-UNNAMED \
  --add-opens=java.sql/java.sql=ALL-UNNAMED \
  ${DBX_JAVA_OPTS:-} \
  -Dfile.encoding=UTF-8 \
  -Dsun.stdout.encoding=UTF-8 \
  -Dsun.stderr.encoding=UTF-8 \
  -jar "$DIR/../lib/dbx-jdbc-plugin.jar"
