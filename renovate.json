{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "schedule": ["at any time"],
  "prConcurrentLimit": 8,
  "prHourlyLimit": 4,
  "labels": ["dependencies"],
  "packageRules": [
    { "matchFileNames": ["vendor/**"], "enabled": false },
    { "matchManagers": ["npm"], "matchUpdateTypes": ["minor", "patch"], "groupName": "npm minor/patch" },
    { "matchManagers": ["cargo"], "matchUpdateTypes": ["minor", "patch"], "groupName": "cargo minor/patch" },
    { "matchManagers": ["gomod"], "matchUpdateTypes": ["minor", "patch"], "groupName": "go minor/patch" },
    { "matchManagers": ["github-actions"], "matchUpdateTypes": ["minor", "patch"], "groupName": "ci actions" }
  ]
}
